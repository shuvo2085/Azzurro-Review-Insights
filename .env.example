# Gemini API key (server-side only). Create one in Google AI Studio.
GEMINI_API_KEY=
# Optional model override. Gemini retires model ids over time; if this one is
# unavailable the API route falls back through other flash models.
GEMINI_MODEL=gemini-3.6-flash

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep this key server-only. Never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
